{
  "name": "@tellus-ai/audio-sdk-workspace",
  "version": "0.2.2",
  "private": true,
  "workspaces": [
    "platforms/*"
  ],
  "description": "Tellus platform installers and package assembly",
  "scripts": {
    "build": "node scripts/assemble-platforms.js",
    "test": "npm run build && node --test scripts/*.test.js",
    "check:js": "npm run build && node scripts/check-javascript.js",
    "check:package": "npm run build && node scripts/check-platform-packages.js",
    "verify:pre-commit": "npm test && npm run check:js && npm run check:package"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellus-ai/tellus-audio-sdk.git"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "@expo/config-plugins": "55.0.11",
    "react-native": "0.83.9"
  }
}
