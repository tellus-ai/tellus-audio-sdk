{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "rootDirs": [
      "src",
      ".generated"
    ],
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/installer/**/*.ts"
  ]
}
